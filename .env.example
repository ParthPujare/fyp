# ---- Docker (read by `docker compose` only; the app itself ignores these) ----
# Host port for the dashboard UI. Change it if 8006 is already taken on your machine.
# DASHBOARD_PORT=8006
# Only used with docker-compose.api-ports.yml (optional raw-API ports for curl demos).
# AUTH_PORT=18000
# GATEWAY_PORT=18001
# Local models (LM Studio / Ollama) run on YOUR machine, not in the container: inside
# Docker use http://host.docker.internal:1234/v1 instead of http://localhost:1234/v1.

# ---- Shared database (Mk13) — Neon Postgres ----
# Leave commented out to keep using local SQLite files (the default; fully offline).
# To share ONE database across the team: Neon dashboard -> your project -> Connect ->
# tick "Connection pooling" -> copy the string (host contains "-pooler") and paste it into YOUR
# .env (not into this example file), exactly as shown — keep ?sslmode=require and anything after
# it. .env is git-ignored and kept out of the Docker image; never commit or paste it elsewhere.
# On start-up the app connects and applies pending schema migrations (and refuses to start if
# it cannot connect, so a typo is caught immediately).  Check it any time with:
#   docker compose exec app python -m app.db check
# WHAT IS SHARED (Mk13 Phase 5): members/departments/LLM keys/connections, approvals, memory
# facts, chat history and paused runs (approve on any machine), run traces, episodic recall and
# the audit log (one hash chain for everyone). STILL PER-MACHINE: policy rules and skills.
# Old local accounts/chats are NOT copied over: outside dev the shared database starts
# EMPTY (Mk19: demo accounts seed only when ALLOW_DEV_SECRETS=1); in dev it starts with
# the 5 demo accounts. Free space when the 512 MB Neon tier fills up:  python -m app.db prune --help
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ---- App ----
APP_NAME=fyp-agent-harness
ENV=dev
# Mk19: explicit hatch to run with the repo-public dev secrets below
# (JWT__SECRET, LLM__FERNET_KEY). Only valid with ENV=dev; ENV=prod refuses
# even with this set. docker-compose.yml and scripts/run_dev.sh default it to
# 1 for local dev — remove both in any real deployment and set real secrets.
ALLOW_DEV_SECRETS=1

# ---- JWT (mock auth) ----
# HS256 secret for issuing/verifying mock tokens (>=32 bytes). Change in production.
JWT__SECRET=dev-secret-change-me-0123456789abcdef
JWT__ALGORITHM=HS256
JWT__EXPIRY_MINUTES=60

# ---- LLM ----
# provider: "mock" (deterministic, offline, CI) | openai | gemini | anthropic |
#           groq | openrouter | custom_openai  ("litellm" parses as a legacy alias)
# These are the fallback/global settings: a member's own BYOK key (Account tab)
# takes precedence for their own runs. Without an API key the app stays on mock.
LLM__PROVIDER=mock
LLM__MODEL=gemini/gemini-3.6-flash
LLM__API_KEY=
# custom_openai / self-hosted endpoints only
LLM__BASE_URL=
# Fernet key encrypting members' stored API keys at rest (generate:
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
# Leave this line commented out for local dev (a public dev default is used). Do NOT set it
# to an empty value: blank means "not configured" and saving API keys returns 503.
# ENV!=dev refuses to start with the built-in default, so set a real key there.
# LLM__FERNET_KEY=
LLM__TEMPERATURE=0.2
LLM__MAX_TOKENS=1024

# ---- Platform memory extractor (Mk16) — NOT part of BYOK ----
# One shared OpenRouter key serves every user server-side for durable-fact
# extraction only; chat itself stays BYOK-only. No user setup needed: without a
# key the extractor falls back to heuristics and everything keeps working.
# PRIMARY store is the shared database: an admin pastes the key once in the
# dashboard Memory tab ("Platform extractor" card) and EVERY instance on the
# same DATABASE_URL uses that exact row (Fernet-encrypted at rest, `:free`
# model enforced, never shown back). These env names are only the
# pre-bootstrap fallback / local-dev override — DB wins when both exist, and
# the DB row is never auto-filled from here (explicit paste only).
# Canonical name is SYSTEM__OPENROUTER_API_KEY; legacy OPENROUTER_API_KEY is
# also accepted. Model must end with `:free` (free routing — without the
# suffix OpenRouter bills). Never commit a real key: share values over a
# private channel like DATABASE_URL.
# OPENROUTER_API_KEY=
# SYSTEM__MODEL=qwen/qwen3.8-27b:free
# SYSTEM__TEMPERATURE=0.0
# SYSTEM__MAX_TOKENS=512
# SYSTEM__TIMEOUT_SECONDS=15.0

# ---- Agent loop guardrails (weeks 3-4) ----
# Note: block is named GUARDRAILS__ (not AGENT__) to avoid a collision with a
# generic `AGENT=1` env var that some shells/terminals export.
GUARDRAILS__MAX_STEPS=10
GUARDRAILS__TOOL_BUDGET=8
GUARDRAILS__CALL_TIMEOUT_SECONDS=30.0
GUARDRAILS__RUN_TIMEOUT_SECONDS=120.0

# ---- Approvals (Mk15) ----
# risk=critical tools always suspend (department head first, then an admin).
# Set to true to ALSO suspend risk=write department tools (e.g. crm_create_campaign)
# for the department head; these are the tool actions a head can "always allow".
APPROVALS__GATE_WRITE_TOOLS=false

# ---- Outbound URL policy (Mk20) ----
# Member-supplied model URLs that resolve to localhost / a private network may only use
# these ports (LM Studio 1234, Ollama 11434, llama.cpp 8080). Public URLs are unaffected.
SECURITY__LOCAL_LLM_PORTS=[1234,11434,8080]
# Admin escape hatch: allow ANY port on a private address (e.g. an internal LLM gateway on 443).
SECURITY__ALLOW_ANY_PRIVATE_PORT=false

# ---- Services (runtime topology, ports 8000-8005) ----
SERVICES__DATA_DIR=data
SERVICES__AUDIT_PATH=data/audit.jsonl
SERVICES__MEMBERS_PATH=data/members.sqlite
SERVICES__MEMORY_PATH=data/memory.sqlite
SERVICES__CHECKPOINT_PATH=data/checkpoints.sqlite
SERVICES__AUTH_URL=http://127.0.0.1:8000
SERVICES__GATEWAY_URL=http://127.0.0.1:8001
SERVICES__DASHBOARD_URL=http://127.0.0.1:8006
SERVICES__CRM_URL=http://127.0.0.1:8002
SERVICES__HR_URL=http://127.0.0.1:8003
SERVICES__DEVOPS_URL=http://127.0.0.1:8004
SERVICES__FINANCE_URL=http://127.0.0.1:8005
# Optional HMAC key for the audit hash chain (tamper-evidence against someone who can
# edit files but doesn't hold this key). Set it BEFORE the first audit line is written.
# With DATABASE_URL set, every laptop appends to ONE chain: all of them must use the SAME key
# (or all leave it blank) — a laptop with a different key reports the chain as tampered.
SERVICES__AUDIT_HMAC_KEY=

# ---- Memory (3-tier + episodic, weeks 7-8) ----
# Per-tier budget caps enforced at write time; oldest-out eviction within a tier.
MEMORY__CENTRAL_BYTES=8192
MEMORY__DEPT_BYTES=16384
MEMORY__USER_BYTES=4096
MEMORY__SNAPSHOT_MAX_CHARS=6000
MEMORY__RECALL_TOP_K=5
MEMORY__EPISODIC_SCOPE=dept

# ---- External tools (Mk9: hybrid Composio + direct) ----
# Per-user BYO Composio key (Account → Integrations) wins; global is fallback.
# Auth configs: Composio dashboard → Auth Configs (Composio-managed OAuth) → paste IDs.
COMPOSIO__API_KEY=
COMPOSIO__BASE_URL=
COMPOSIO__TIMEOUT_SECONDS=30.0
COMPOSIO__GMAIL_AUTH_CONFIG=
COMPOSIO__GITHUB_AUTH_CONFIG=


DATABASE_URL=