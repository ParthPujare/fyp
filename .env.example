# ---- App ----
APP_NAME=fyp-agent-harness
ENV=dev

# ---- JWT (mock auth) ----
# HS256 secret for issuing/verifying mock tokens (>=32 bytes). Change in production.
JWT__SECRET=dev-secret-change-me-0123456789abcdef
JWT__ALGORITHM=HS256
JWT__EXPIRY_MINUTES=60

# ---- LLM ----
# provider: "mock" (deterministic, offline, CI) | openai | gemini | anthropic |
#           groq | openrouter | custom_openai  ("litellm" parses as a legacy alias)
# These are the fallback/global settings: a member's own BYOK key (Account tab)
# takes precedence for their own runs. Without an API key the app stays on mock.
LLM__PROVIDER=mock
LLM__MODEL=gemini/gemini-3.6-flash
LLM__API_KEY=
# custom_openai / self-hosted endpoints only
LLM__BASE_URL=
# Fernet key encrypting members' stored API keys at rest (generate:
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`)
# Leave this line commented out for local dev (a public dev default is used). Do NOT set it
# to an empty value: blank means "not configured" and saving API keys returns 503.
# ENV!=dev refuses to start with the built-in default, so set a real key there.
# LLM__FERNET_KEY=
LLM__TEMPERATURE=0.2
LLM__MAX_TOKENS=1024

# ---- Agent loop guardrails (weeks 3-4) ----
# Note: block is named GUARDRAILS__ (not AGENT__) to avoid a collision with a
# generic `AGENT=1` env var that some shells/terminals export.
GUARDRAILS__MAX_STEPS=10
GUARDRAILS__TOOL_BUDGET=8
GUARDRAILS__CALL_TIMEOUT_SECONDS=30.0
GUARDRAILS__RUN_TIMEOUT_SECONDS=120.0

# ---- Services (runtime topology, ports 8000-8005) ----
SERVICES__DATA_DIR=data
SERVICES__AUDIT_PATH=data/audit.jsonl
SERVICES__MEMBERS_PATH=data/members.sqlite
SERVICES__MEMORY_PATH=data/memory.sqlite
SERVICES__CHECKPOINT_PATH=data/checkpoints.sqlite
SERVICES__AUTH_URL=http://127.0.0.1:8000
SERVICES__GATEWAY_URL=http://127.0.0.1:8001
SERVICES__DASHBOARD_URL=http://127.0.0.1:8006
SERVICES__CRM_URL=http://127.0.0.1:8002
SERVICES__HR_URL=http://127.0.0.1:8003
SERVICES__DEVOPS_URL=http://127.0.0.1:8004
SERVICES__FINANCE_URL=http://127.0.0.1:8005
# Optional HMAC key for the audit hash chain (tamper-evidence against someone who can
# edit files but doesn't hold this key). Set it BEFORE the first audit line is written.
SERVICES__AUDIT_HMAC_KEY=

# ---- Memory (3-tier + episodic, weeks 7-8) ----
# Per-tier budget caps enforced at write time; oldest-out eviction within a tier.
MEMORY__CENTRAL_BYTES=8192
MEMORY__DEPT_BYTES=16384
MEMORY__USER_BYTES=4096
MEMORY__SNAPSHOT_MAX_CHARS=6000
MEMORY__RECALL_TOP_K=5
MEMORY__EPISODIC_SCOPE=dept

# ---- External tools (Mk9: hybrid Composio + direct) ----
# Per-user BYO Composio key (Account → Integrations) wins; global is fallback.
# Auth configs: Composio dashboard → Auth Configs (Composio-managed OAuth) → paste IDs.
COMPOSIO__API_KEY=
COMPOSIO__BASE_URL=
COMPOSIO__TIMEOUT_SECONDS=30.0
COMPOSIO__GMAIL_AUTH_CONFIG=
COMPOSIO__GITHUB_AUTH_CONFIG=
