# ---- App ----
APP_NAME=fyp-agent-harness
ENV=dev

# ---- JWT (mock auth) ----
# HS256 secret for issuing/verifying mock tokens (>=32 bytes). Change in production.
JWT__SECRET=dev-secret-change-me-0123456789abcdef
JWT__ALGORITHM=HS256
JWT__EXPIRY_MINUTES=60

# ---- LLM ----
# provider: "mock" (deterministic, offline, CI) | "litellm" (real model via LiteLLM)
LLM__PROVIDER=mock
LLM__MODEL=gemini/gemini-2.0-flash
LLM__API_KEY=
LLM__TEMPERATURE=0.2
LLM__MAX_TOKENS=1024

# ---- Services (runtime topology, ports 8000-8005) ----
SERVICES__DATA_DIR=data
SERVICES__AUTH_URL=http://127.0.0.1:8000
SERVICES__GATEWAY_URL=http://127.0.0.1:8001
SERVICES__CRM_URL=http://127.0.0.1:8002
SERVICES__HR_URL=http://127.0.0.1:8003
SERVICES__DEVOPS_URL=http://127.0.0.1:8004
SERVICES__FINANCE_URL=http://127.0.0.1:8005
